# Local staging rehearsal only. Copy to .env.staging and replace every placeholder.
# Do not use production credentials or real customer data in this environment.
APP_ENV_FILE=.env.staging
POSTGRES_DB=bahulu_staging
POSTGRES_USER=bahulu_staging
POSTGRES_PASSWORD=replace-with-a-local-staging-password
SECRET_KEY=replace-with-a-random-secret-at-least-32-characters-long
OPENAI_API_KEY=replace-with-your-test-key
OPENAI_MODEL=gpt-4o-mini
OPENAI_REASONING_EFFORT=none
AI_MONTHLY_BUDGET_USD=8
AI_DISPLAY_EXCHANGE_RATE=4.4
AI_BUDGET_WARNING_THRESHOLD=0.8
AI_MAX_COMPLETION_TOKENS=600
AI_MAX_RESERVED_INPUT_TOKENS=32000
STRIPE_SECRET_KEY=replace-with-your-stripe-test-key
STRIPE_WEBHOOK_SECRET=replace-with-your-stripe-test-webhook-secret
STRIPE_SUCCESS_URL=http://localhost:15173/payment/success
STRIPE_CANCEL_URL=http://localhost:15173/payment/cancel
VITE_API_BASE_URL=http://localhost:18000/api
VITE_STOREFRONT_BASE_URL=http://localhost:13000
STOREFRONT_API_BASE_URL=http://localhost:18000/api
STOREFRONT_SERVER_API_BASE_URL=http://api:8000/api
STOREFRONT_WHATSAPP_NUMBER=
API_BIND_ADDRESS=127.0.0.1
API_PORT=18000
FRONTEND_BIND_ADDRESS=127.0.0.1
FRONTEND_PORT=15173
STOREFRONT_BIND_ADDRESS=127.0.0.1
STOREFRONT_PORT=13000
STAGING_ALLOWED_ORIGINS=http://localhost:15173,http://localhost:13000
STAGING_TRUSTED_HOSTS=localhost,127.0.0.1,api
WHATSAPP_META_INBOUND_ENABLED=false
EMAIL_PROVIDER=console
EMAIL_FROM=Bahulu Berry Cameron <notifications@example.invalid>
RESEND_API_KEY=
APP_BASE_URL=http://localhost:15173
PASSWORD_RESET_EXPIRE_MINUTES=30
