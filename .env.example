# Copy to .env before running Docker Compose. Replace every placeholder locally.
POSTGRES_DB=bahulu
POSTGRES_USER=bahulu
POSTGRES_PASSWORD=replace-with-a-local-only-password
SECRET_KEY=replace-with-a-random-secret-at-least-32-characters-long
OPENAI_API_KEY=replace-with-your-key
OPENAI_MODEL=gpt-4o-mini
OPENAI_REASONING_EFFORT=none
AI_MONTHLY_BUDGET_USD=15
AI_DISPLAY_EXCHANGE_RATE=4.4
AI_BUDGET_WARNING_THRESHOLD=0.8
AI_MAX_COMPLETION_TOKENS=350
AI_MAX_RESERVED_INPUT_TOKENS=32000
WHATSAPP_RAG_ENABLED=false
WHATSAPP_RAG_MODEL=gpt-4o-mini
WHATSAPP_RAG_EMBEDDING_MODEL=text-embedding-3-small
WHATSAPP_RAG_MONTHLY_BUDGET_USD=10
WHATSAPP_RAG_MAX_COMPLETION_TOKENS=180
WHATSAPP_RAG_MAX_CONTEXT_TOKENS=1200
WHATSAPP_RAG_MIN_SIMILARITY=0.72
STRIPE_SECRET_KEY=replace-with-your-stripe-test-key
STRIPE_WEBHOOK_SECRET=replace-with-your-stripe-webhook-secret
STRIPE_SUCCESS_URL=http://localhost:3000/checkout/success
STRIPE_CANCEL_URL=http://localhost:3000/checkout/cancelled
# Website checkout stays off until approved. With it on, only Stripe test keys
# (sk_test_...) are accepted unless PAYMENTS_LIVE_APPROVED=true.
PAYMENT_PROVIDER=stripe
STOREFRONT_CHECKOUT_ENABLED=false
PAYMENTS_LIVE_APPROVED=false
STOREFRONT_UNPAID_ORDER_MINUTES=45
WHATSAPP_META_INBOUND_ENABLED=false
WHATSAPP_META_APP_SECRET=replace-only-after-meta-approval
WHATSAPP_META_VERIFY_TOKEN=replace-only-after-meta-approval
WHATSAPP_META_PHONE_NUMBER_ID=replace-only-after-meta-approval
VITE_API_BASE_URL=/api
VITE_STOREFRONT_BASE_URL=http://localhost:3000
STOREFRONT_API_BASE_URL=http://localhost:8000/api
STOREFRONT_SERVER_API_BASE_URL=http://api:8000/api
STOREFRONT_CHECKOUT_PREVIEW_ENABLED=false
# Keep this off until the listing, public policies, and restricted keys are approved.
STOREFRONT_GOOGLE_INTEGRATIONS_ENABLED=false
GOOGLE_PLACES_API_KEY=
GOOGLE_MAPS_EMBED_API_KEY=
# Add the approved WhatsApp number in international digits only, e.g. 60123456789.
STOREFRONT_WHATSAPP_NUMBER=
EMAIL_PROVIDER=console
EMAIL_FROM=Bahulu Berry Cameron <notifications@example.invalid>
RESEND_API_KEY=
APP_BASE_URL=http://localhost:5173
PASSWORD_RESET_EXPIRE_MINUTES=30
# Keep false locally. Only set true when every public route passes through
# Cloudflare, otherwise clients can forge their IP (see docs/security.md).
TRUST_CLOUDFLARE_CLIENT_IP=false
# Logs are JSON with personal data redacted; "text" is easier to read locally.
LOG_LEVEL=INFO
LOG_FORMAT=json
# Optional error alerts. Leave empty until the client owns a Sentry account.
SENTRY_DSN=
# Backups (docker compose --profile backup run --rm backup). AGE_RECIPIENT is
# the age PUBLIC key (age1...). Keep the private key offline, never beside the
# backups. On Linux, BACKUP_DIR must be writable by uid 999.
AGE_RECIPIENT=
BACKUP_DIR=./backups
