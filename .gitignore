# Frontend (Node/Vite)
# =====================

frontend/node_modules/
storefront/node_modules/
storefront/.next/
storefront/out/
storefront/.env
frontend/dist/
frontend/dist-ssr/

frontend/*.local

frontend/npm-debug.log*
frontend/yarn-debug.log*
frontend/yarn-error.log*
frontend/pnpm-debug.log*
frontend/test-results/
frontend/playwright-report/
frontend/blob-report/
.playwright-cli/
/output/playwright/
/security-reports/

# Local environment files and secrets
# Keep only the reviewed templates in Git. This covers Docker, Vite, Next.js,
# and backend environment files at any depth.
.env
.env.*
**/.env
**/.env.*
!.env.example
!.env.staging.example
!.env.demo.example
!**/.env.example
!**/.env.staging.example
.envrc

# Private keys, certificates, credential exports, and local database dumps.
# Never place real values in an example/template file.
*.pem
*.key
*.p12
*.pfx
*.jks
*.dump
*.sqlite3
secrets/
credentials/


