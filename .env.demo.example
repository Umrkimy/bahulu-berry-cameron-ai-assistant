# Copy this file to .env.demo. Use test/demo records only and never commit it.
APP_ENV_FILE=.env.demo
APP_ENVIRONMENT=staging

POSTGRES_DB=bahulu_demo
POSTGRES_USER=bahulu_demo
POSTGRES_PASSWORD=replace-with-a-unique-demo-password
SECRET_KEY=replace-with-a-random-secret-at-least-32-characters-long
OPENAI_API_KEY=replace-with-a-test-key-or-leave-the-assistant-unused
OPENAI_MODEL=gpt-4o-mini
OPENAI_REASONING_EFFORT=none
AI_MONTHLY_BUDGET_USD=15
AI_DISPLAY_EXCHANGE_RATE=4.4
AI_BUDGET_WARNING_THRESHOLD=0.8
AI_MAX_COMPLETION_TOKENS=350
AI_MAX_RESERVED_INPUT_TOKENS=32000
WHATSAPP_RAG_ENABLED=false
WHATSAPP_RAG_MODEL=gpt-4o-mini
WHATSAPP_RAG_EMBEDDING_MODEL=text-embedding-3-small
WHATSAPP_RAG_MONTHLY_BUDGET_USD=10
WHATSAPP_RAG_MAX_COMPLETION_TOKENS=180
WHATSAPP_RAG_MAX_CONTEXT_TOKENS=1200
WHATSAPP_RAG_MIN_SIMILARITY=0.72
STRIPE_SECRET_KEY=replace-with-a-stripe-test-key
STRIPE_WEBHOOK_SECRET=replace-with-a-stripe-test-webhook-secret
STRIPE_SUCCESS_URL=https://demo.example.com/payment/success
STRIPE_CANCEL_URL=https://demo.example.com/payment/cancel

# Replace demo.example.com with a hostname in a domain managed by Cloudflare.
DEMO_PUBLIC_HOST=demo.example.com
ALLOWED_ORIGINS=https://demo.example.com
TRUSTED_HOSTS=localhost,127.0.0.1,api,demo.example.com
STAGING_ALLOWED_ORIGINS=https://demo.example.com
STAGING_TRUSTED_HOSTS=localhost,127.0.0.1,api,demo.example.com
APP_BASE_URL=https://demo.example.com

# The dashboard uses one public origin; Nginx forwards /api to the Docker API.
VITE_API_BASE_URL=/api
VITE_STOREFRONT_BASE_URL=https://demo.example.com
STOREFRONT_API_BASE_URL=https://demo.example.com/api
STOREFRONT_SERVER_API_BASE_URL=http://api:8000/api
STOREFRONT_WHATSAPP_NUMBER=

WHATSAPP_META_INBOUND_ENABLED=false
WHATSAPP_META_APP_SECRET=
WHATSAPP_META_VERIFY_TOKEN=
WHATSAPP_META_PHONE_NUMBER_ID=
EMAIL_PROVIDER=console
EMAIL_FROM=Bahulu Berry Cameron <notifications@example.invalid>
RESEND_API_KEY=
PASSWORD_RESET_EXPIRE_MINUTES=30

# Cloudflare Dashboard > Networking > Tunnels > your tunnel > token.
# Keep this value in .env.demo only; it grants the connector access to the tunnel.
CLOUDFLARE_TUNNEL_TOKEN=replace-with-your-cloudflare-tunnel-token

# Do not expose Docker directly to the LAN or Internet for a client demo.
API_BIND_ADDRESS=127.0.0.1
API_PORT=8000
FRONTEND_BIND_ADDRESS=127.0.0.1
FRONTEND_PORT=5173
STOREFRONT_BIND_ADDRESS=127.0.0.1
STOREFRONT_PORT=3000
